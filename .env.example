# LexAudit Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env — it is git-ignored.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# ── Storage (optional — defaults work for local dev) ─────────────────────────
# Where ChromaDB stores its vector data
CHROMA_PERSIST_PATH=./chroma_data

# Where audit reports are saved as JSON
REPORTS_DIR=./audit_reports

# ── App Config (optional overrides) ──────────────────────────────────────────
# Similarity threshold for grounding (0.0–1.0). Lower = more permissive.
GROUNDING_THRESHOLD=0.65

# NVIDIA NIM model to use
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Set to true for verbose debug logging
DEBUG=false
